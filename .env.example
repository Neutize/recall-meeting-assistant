# Required for creating bots and downloading Recall.ai transcript artifacts.
RECALLAI_API_KEY=
RECALLAI_REGION=us-east-1

# Required by the HTTPS webhook receiver. Copy the whsec_ value from Recall.ai.
RECALLAI_WEBHOOK_SECRET=
# Optional local-development alternative when signed webhooks are unavailable.
RECALL_WEBHOOK_TOKEN=

# The public HTTPS origin where Recall.ai will send webhooks (documentation only).
MEETING_ASSISTANT_PUBLIC_BASE_URL=https://meet.example.com

# Runtime paths. These defaults keep private recordings/transcripts under ./data.
MEETING_ASSISTANT_HOME=./data
MEETING_ASSISTANT_STORAGE_DIR=./data/meetings
MEETING_ASSISTANT_WEBHOOK_DIR=./data/webhooks
# MEETING_ASSISTANT_PROCESSED_FILE=./data/meetings/ingest_processed.json
# MEETING_ASSISTANT_PARTICIPANT_MAP=./data/participants.yaml

# Recall bot defaults.
MEETING_ASSISTANT_BOT_NAME=Meeting Notetaker
MEETING_ASSISTANT_LANGUAGE_CODE=auto
MEETING_ASSISTANT_TRANSCRIPTION_MODE=prioritize_accuracy
MEETING_ASSISTANT_ALLOWED_DOMAINS=meet.google.com

# Telegram delivery. Leave blank to keep messages in the local outbox only.
MEETING_ASSISTANT_TELEGRAM_BACKEND=telegram
TELEGRAM_BOT_TOKEN=
MEETING_ASSISTANT_TELEGRAM_CHAT_ID=
MEETING_ASSISTANT_TELEGRAM_THREAD_ID=

# Optional OpenAI fallback for an injected recording transcriber.
OPENAI_API_KEY=
MEETING_ASSISTANT_OPENAI_FALLBACK_MODEL=gpt-4o-transcribe
MEETING_ASSISTANT_FALLBACK_POLICY=auto
MEETING_ASSISTANT_MONTHLY_COST_CAP_USD=
